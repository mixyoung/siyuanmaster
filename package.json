{
  "name": "siyuanmaster",
  "version": "0.5.1",
  "private": true,
  "description": "SiYuanMaster — policy-aware SiYuan access boundary and safe write tools for trusted local agents.",
  "scripts": {
    "generate": "node scripts/generate-capabilities.mjs",
    "check:catalog": "node scripts/check-capabilities.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "smoke:mcp:write": "node scripts/mcp-write-smoke.mjs",
    "dev:local": "pwsh -NoProfile -File scripts/dev-local.ps1",
    "build:package": "node scripts/build.mjs",
    "build": "pnpm run generate && pnpm run check:catalog && pnpm run typecheck && pnpm run build:package && pnpm run test"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.6",
    "siyuan": "1.2.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
