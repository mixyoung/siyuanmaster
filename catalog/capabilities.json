{
  "schemaVersion": 1,
  "product": {
    "id": "siyuanmaster",
    "technicalId": "siyuanmaster",
    "displayName": {
      "default": "SiYuanMaster",
      "zh-CN": "思源大师"
    },
    "version": "0.5.0",
    "minAppVersion": "3.7.0"
  },
  "namespaces": {
    "plugin": "plugin__siyuanmaster__",
    "gateway": "siyuanmaster"
  },
  "pluginTools": [
    {
      "name": "get_policy",
      "category": "policy",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "list_accessible_notebooks",
      "category": "notebook",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "list_document_tree",
      "category": "tree",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "search_notes",
      "category": "search",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "read_note",
      "category": "read",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "resolve_document",
      "category": "read",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "read_note_segments",
      "category": "read",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "create_note",
      "category": "write",
      "readOnly": false,
      "confirmDefault": false
    },
    {
      "name": "append_note",
      "category": "write",
      "readOnly": false,
      "confirmDefault": false
    },
    {
      "name": "update_note",
      "category": "write",
      "readOnly": false,
      "confirmDefault": true
    },
    {
      "name": "edit_block",
      "category": "block",
      "readOnly": false,
      "confirmDefault": true
    },
    {
      "name": "rename_note",
      "category": "structure",
      "readOnly": false,
      "confirmDefault": true
    },
    {
      "name": "move_note",
      "category": "structure",
      "readOnly": false,
      "confirmDefault": true
    },
    {
      "name": "delete_note",
      "category": "write",
      "readOnly": false,
      "confirmDefault": true
    },
    {
      "name": "suggest_tags",
      "category": "tag",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "apply_tags",
      "category": "tag",
      "readOnly": false,
      "confirmDefault": false
    },
    {
      "name": "prepare_summary",
      "category": "read",
      "readOnly": true,
      "confirmDefault": false
    },
    {
      "name": "save_memory",
      "category": "write",
      "readOnly": false,
      "confirmDefault": false
    },
    {
      "name": "get_audit_log",
      "category": "audit",
      "readOnly": true,
      "confirmDefault": false
    }
  ],
  "gateway": {
    "endpoints": [
      {
        "path": "/healthz",
        "method": "GET",
        "auth": "none",
        "audited": false
      },
      {
        "path": "/v1/capabilities",
        "method": "GET",
        "auth": "none",
        "audited": false
      },
      {
        "path": "/v1/token/verify",
        "method": "POST",
        "auth": "none",
        "audited": true
      },
      {
        "path": "/v1/audit",
        "method": "GET",
        "auth": "scope:audit:read",
        "audited": false
      },
      {
        "path": "/v1/txn/preview",
        "method": "POST",
        "auth": "scope:txn:write",
        "audited": true
      },
      {
        "path": "/v1/txn/confirm",
        "method": "POST",
        "auth": "scope:txn:write",
        "audited": true
      }
    ],
    "token": {
      "format": "smt1.<payloadB64Url>.<macB64Url>",
      "algorithm": "HMAC-SHA256",
      "defaultTtlSeconds": 3600,
      "scopes": [
        "catalog:read",
        "op:read",
        "op:write",
        "txn:write",
        "audit:read",
        "notebook:read:<notebookId>",
        "notebook:write:<notebookId>"
      ]
    }
  },
  "writeTransaction": {
    "name": "SafeWriteTxn",
    "maxPreviewAgeSeconds": 600,
    "states": [
      "previewed",
      "awaiting_confirmation",
      "confirmed",
      "executing",
      "verifying",
      "committed",
      "failed",
      "unknown"
    ],
    "events": [
      "prepare",
      "snapshot_failed",
      "snapshot_ok",
      "confirm",
      "state_mismatch",
      "execute",
      "readback_ok",
      "readback_failed",
      "uncertain"
    ],
    "terminalStates": [
      "committed",
      "failed",
      "unknown"
    ],
    "invariants": [
      "snapshot_failure_stops",
      "exactly_once",
      "no_auto_retry_on_uncertain",
      "state_or_hash_check_required",
      "readback_required",
      "audit_without_body"
    ]
  },
  "security": {
    "defaultDeny": true,
    "adminTokenStaysInTrustedBoundary": true,
    "auditBodyRedaction": true
  },
  "compatibility": {
    "originalToolCount": 16,
    "technicalIdPolicy": "siyuanmaster-with-storage-migration",
    "note": "0.5.0 technical ID is siyuanmaster; MCP tools are plugin__siyuanmaster__*. On first load, policy/audit are auto-copied from data/storage/petal/siyuan-agent-access/ into data/storage/petal/siyuanmaster/ when the new side is missing (new always wins; fail-closed defaults; migration marker for idempotency). The legacy petal directory is retained and never deleted. External agent/skill configs must still be updated manually to the new MCP namespace."
  }
}
